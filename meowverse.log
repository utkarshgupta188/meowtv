[2026-05-01T13:40:25.497Z] FULL INFO: {"vod_total":10,"pianwei":0,"vod_serial":2,"piantou":0,"vod_year":"2026","vod_behind":"","click_count":579,"vod_isend":0,"vod_director":"Hiro Murai","is_best":1,"vod_name":"Widow's Bay - Season 1","vod_tag":"Comedy/Drama/Horror","vod_lang":"hi","vod_writer":"eng","vod_weekday":"","upload_user_head_img":"","id":565794,"vod_nc_show_id":3250235,"vod_douban_score":9,"icon_type":0,"vod_pic":"https://6rga.a0p3.com/img/vod_pic/20260429/c18c29e55bfd.jpg","is_share":0,"hide_ad":0,"is_selected":0,"type_id":0,"vod_version":"{\"is_update\":1,\"update_episode\":\"2,0,0\"}","upload_user_name":"","type_pid":2,"vod_pubdate":"","vod_blurb":"Widow's Bay is a quaint island town 40 miles off the coast of New England. But something lurks beneath the surface. Mayor Tom Loftis is desperate to revive his struggling community. There's no Wi-Fi, spotty cellular reception and he must contend with superstitious locals who believe their island is cursed. He wants these people to respect him. They don't. They think he is soft and cowardly. And he is. But Loftis is determined to build a better future for his teenage son and turn the island into a tourist destination. Miraculously, he succeeds: tourists are finally coming. Unfortunately, the locals were right. After decades of calm, the old stories that seemed too ludicrous to be true start happening again.","production_country":"us","vod_en":"Widow's Bay - Season 1","vod_actor":"Matthew Rhys,Stephen Root,Kate O'Flynn","audio_type":1,"audio_type_option":[{"type":1,"type_name":"Original"}],"vod_collection":[{"id":5794610,"title":"1","source_id":1000,"is_selected":0,"vod_id":565794,"collection":1,"vod_url":"http://6rga.a0p3.com/vod/1/2026/04/29/2acf84007051/314133517.mp4","type":2,"time_up":0,"down_url":"http://6rga.a0p3.com/vod/1/2026/04/29/2acf84007051/314133517.mp4","is_ad":0,"duration":"00:41:29","is_p2p":1,"vod_duration":2489},{"id":5797913,"title":"2","source_id":1000,"is_selected":0,"vod_id":565794,"colle